# 配置示例：复制成 .env 后按需修改
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env
#
# .env 已在 .gitignore 里，不会被提交。
# 所有项都有代码内默认值，不填也能跑；只想改某一项时，只写那一行即可。

# ---------- 模型服务 ----------
# 本地跑：保持默认
# 容器里跑：改成 http://host.docker.internal:11434
OLLAMA_BASE=http://localhost:11434

CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=bge-m3
REQUEST_TIMEOUT=120

# ---------- 检索 ----------
# 相似度阈值：越小越严格（更容易拒答）。
# ★ 这个值随知识库规模变化 —— 库变了必须重新标定（跑 eval_retrieval.py）。
#   2822 块真实库上用 19 条问题扫出来的最优值是 0.44（0.44~0.45 稳定）。
MAX_DISTANCE=0.44
TOP_K=3
CANDIDATE_K=10

# ---------- 切块 ----------
CHUNK_SIZE=100

# ---------- PDF 清洗 ----------
# 某行出现在多少比例的页面里才当页眉页脚删掉。
# 真页眉约 99%，章节标题/表格表头约 24%~33% —— 调低会误删正文，调高会漏删页眉。
PDF_REPEAT_MIN_RATIO=0.5

# ---------- 建库 ----------
# 每批嵌入多少块。整本手册几千块，一次性发给 Ollama 会超时（实测 2822 块直接 ReadTimeout）。
EMBED_BATCH_SIZE=64

# ---------- Agent ----------
MAX_STEPS=4

# ---------- 接口 ----------
API_HOST=127.0.0.1
API_PORT=8000
