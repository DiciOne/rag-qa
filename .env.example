# 配置示例：复制成 .env 后按需修改
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env
#
# .env 已在 .gitignore 里，不会被提交。
# 所有项都有代码内默认值，不填也能跑；只想改某一项时，只写那一行即可。

# ---------- 模型服务 ----------
# 本地跑：保持默认
# 容器里跑：改成 http://host.docker.internal:11434
OLLAMA_BASE=http://localhost:11434

CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=bge-m3
REQUEST_TIMEOUT=120

# ---------- 检索 ----------
# 相似度阈值：越小越严格（更容易拒答）。按你的知识库实测调，见 README
MAX_DISTANCE=0.5
TOP_K=3
CANDIDATE_K=10

# ---------- 切块 ----------
CHUNK_SIZE=100

# ---------- Agent ----------
MAX_STEPS=4

# ---------- 接口 ----------
API_HOST=127.0.0.1
API_PORT=8000
